VITE_API_URL=http://localhost:3001/api
DATABASE_URL=postgresql://learn_to_learn:learn_to_learn_local@127.0.0.1:5434/learn_to_learn
PORT=3001
AUTH_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false

# Chaves oficiais de teste do Cloudflare Turnstile. Substitua em produção.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Resend: sem ambos os valores, e-mails ficam desabilitados e auditados como SKIPPED.
RESEND_API_KEY=
EMAIL_FROM=

# Nenhum provedor real está configurado neste MVP.
WHATSAPP_PROVIDER=disabled

# Usadas exclusivamente para criar/sincronizar o ADMIN de desenvolvimento.
# Defina valores locais; nunca adicione credenciais reais a este arquivo.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
